generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model administrative_regions {
  id           Int         @id
  name         String      @db.VarChar(255)
  name_en      String      @db.VarChar(255)
  code_name    String?     @db.VarChar(255)
  code_name_en String?     @db.VarChar(255)
  provinces    provinces[]
}

model administrative_units {
  id            Int         @id
  full_name     String?     @db.VarChar(255)
  full_name_en  String?     @db.VarChar(255)
  short_name    String?     @db.VarChar(255)
  short_name_en String?     @db.VarChar(255)
  code_name     String?     @db.VarChar(255)
  code_name_en  String?     @db.VarChar(255)
  districts     districts[]
  provinces     provinces[]
  wards         wards[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model attribute_catalogue_attribute {
  attribute_catalogue_id BigInt               @db.UnsignedBigInt
  attribute_id           BigInt               @db.UnsignedBigInt
  attribute_catalogues   attribute_catalogues @relation(fields: [attribute_catalogue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_catalogue_attribute_attribute_catalogue_id_foreign")
  attributes             attributes           @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_catalogue_attribute_attribute_id_foreign")

  @@index([attribute_catalogue_id], map: "attribute_catalogue_attribute_attribute_catalogue_id_foreign")
  @@index([attribute_id], map: "attribute_catalogue_attribute_attribute_id_foreign")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model attribute_catalogue_language {
  attribute_catalogue_id BigInt               @db.UnsignedBigInt
  language_id            BigInt               @db.UnsignedBigInt
  name                   String
  description            String?              @db.Text
  content                String?              @db.LongText
  meta_title             String?
  meta_keyword           String?
  meta_description       String?              @db.Text
  canonical              String?
  created_at             DateTime?            @db.Timestamp(0)
  updated_at             DateTime?            @db.Timestamp(0)
  attribute_catalogues   attribute_catalogues @relation(fields: [attribute_catalogue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_catalogue_language_attribute_catalogue_id_foreign")
  languages              languages            @relation(fields: [language_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_catalogue_language_language_id_foreign")

  @@index([attribute_catalogue_id], map: "attribute_catalogue_language_attribute_catalogue_id_foreign")
  @@index([language_id], map: "attribute_catalogue_language_language_id_foreign")
  @@ignore
}

model attribute_catalogues {
  id                            BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id                     Int                             @default(0)
  lft                           Int                             @default(0)
  rgt                           Int                             @default(0)
  level                         Int                             @default(0)
  image                         String?
  icon                          String?
  album                         String?                         @db.Text
  publish                       Int                             @default(1) @db.TinyInt
  follow                        Int                             @default(0) @db.TinyInt
  order                         Int                             @default(0)
  user_id                       BigInt                          @db.UnsignedBigInt
  deleted_at                    DateTime?                       @db.Timestamp(0)
  created_at                    DateTime?                       @db.Timestamp(0)
  updated_at                    DateTime?                       @db.Timestamp(0)
  attribute_catalogue_attribute attribute_catalogue_attribute[] @ignore
  attribute_catalogue_language  attribute_catalogue_language[] @ignore
  users                         users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_catalogues_user_id_foreign")

  @@index([user_id], map: "attribute_catalogues_user_id_foreign")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model attribute_language {
  attribute_id     BigInt     @db.UnsignedBigInt
  language_id      BigInt     @db.UnsignedBigInt
  name             String
  description      String?    @db.Text
  content          String?    @db.LongText
  meta_title       String?
  meta_keyword     String?
  meta_description String?    @db.Text
  canonical        String?
  created_at       DateTime?  @db.Timestamp(0)
  updated_at       DateTime?  @db.Timestamp(0)
  attributes       attributes @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_language_attribute_id_foreign")
  languages        languages  @relation(fields: [language_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_language_language_id_foreign")

  @@index([attribute_id], map: "attribute_language_attribute_id_foreign")
  @@index([language_id], map: "attribute_language_language_id_foreign")
  @@ignore
}

model attributes {
  id                            BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  attribute_catalogue_id        Int                             @default(0)
  image                         String?
  icon                          String?
  album                         String?                         @db.Text
  publish                       Int                             @default(1) @db.TinyInt
  follow                        Int                             @default(1) @db.TinyInt
  order                         Int                             @default(0)
  user_id                       BigInt                          @db.UnsignedBigInt
  deleted_at                    DateTime?                       @db.Timestamp(0)
  created_at                    DateTime?                       @db.Timestamp(0)
  updated_at                    DateTime?                       @db.Timestamp(0)
  attribute_catalogue_attribute attribute_catalogue_attribute[] @ignore
  attribute_language            attribute_language[] @ignore
  users                         users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attributes_user_id_foreign")
  product_variant_attribute     product_variant_attribute[] @ignore

  @@index([user_id], map: "attributes_user_id_foreign")
}

model combo_products {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  combo_id         BigInt           @db.UnsignedBigInt
  product_id       BigInt           @db.UnsignedBigInt
  uuid             String           @unique(map: "combo_products_uuid_unique") @db.VarChar(36)
  quantity         Int
  created_at       DateTime?        @db.Timestamp(0)
  updated_at       DateTime?        @db.Timestamp(0)
  promotion_combos promotion_combos @relation(fields: [combo_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "combo_products_combo_id_foreign")
  products         products         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "combo_products_product_id_foreign")

  @@index([combo_id], map: "combo_products_combo_id_foreign")
  @@index([product_id], map: "combo_products_product_id_foreign")
}

model contacts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?
  phone      String?
  address    String?
  gender     Int       @default(0) @db.TinyInt
  product_id BigInt?   @db.UnsignedBigInt
  post_id    BigInt?   @db.UnsignedBigInt
  publish    Int?      @db.TinyInt
