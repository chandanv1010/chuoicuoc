DATABASE_URL="mysql://root:root@127.0.0.1:3306/ten_site"
# Doi chuoi nay khi deploy: dung de ky cookie dang nhap admin
AUTH_SECRET=""

# Tai khoan admin thu tren may dev (scripts/create-admin.mjs)
DEV_ADMIN_EMAIL="admin@example.com"
DEV_ADMIN_PASSWORD=""

# Giong APP_URL cua Laravel (co dau / cuoi)
APP_URL=""
APP_LOCALE="vn"
# Thu muc chua file upload (mac dinh ./storage)
STORAGE_DIR=""

# ---- Mang xa hoi (src/modules/social, huong dan: docs/SOCIAL-API-SETUP.md) ----
# Goc URL HTTPS cong khai (ten mien that hoac cloudflared tunnel): dung lam redirect_uri
# (PUBLIC_BASE_URL/social/callback/{facebook|tiktok|youtube|pinterest}) va de Instagram / anh TikTok tai media.
# De trong -> dung APP_URL. Localhost thi Instagram va dang anh TikTok se bao loi.
PUBLIC_BASE_URL=""
# Khoa ma hoa token (AES-256-GCM): 64 ky tu hex hoac base64 32 byte, vd: openssl rand -hex 32
# Doi khoa = moi tai khoan phai ket noi lai.
SOCIAL_TOKEN_KEY=""
# 1 = moi kenh chi gia lap dang (kiem tra payload, tra id/link gia). Kenh chua co ma app tu dong chay thu.
SOCIAL_DRY_RUN="1"
# Phien ban Graph API cua Meta
META_GRAPH_VERSION="v26.0"
# Meta app (Facebook Page + Instagram), redirect: PUBLIC_BASE_URL/social/callback/facebook
META_APP_ID=""
META_APP_SECRET=""
# TikTok Login Kit + Content Posting API, redirect: PUBLIC_BASE_URL/social/callback/tiktok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# 1 khi app TikTok da qua audit Direct Post (truoc do chi duoc dang SELF_ONLY)
TIKTOK_DIRECT_POST_AUDITED="0"
# Google Cloud (YouTube Data API v3), redirect: PUBLIC_BASE_URL/social/callback/youtube
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Pinterest API v5, redirect: PUBLIC_BASE_URL/social/callback/pinterest
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
# 1 = goi api-sandbox.pinterest.com (Trial access)
PINTEREST_SANDBOX="0"

# X (Twitter) API v2, OAuth 2.0 (Web App), redirect: PUBLIC_BASE_URL/social/callback/x
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# 0 = khong chay worker hang doi trong process web (vd khi chay nhieu instance)
SOCIAL_WORKER="1"
# So WhatsApp quoc te (bo dau + va so 0 dau), them vao noi dung goi y Facebook (link wa.me) / Instagram (so)
SOCIAL_WHATSAPP=""
# Website cong khai dung trong link bai dang (vd https://customstitchhouse.com); trong -> APP_URL
SOCIAL_SITE_URL=""

# --- San TMDT (src/modules/marketplace, docs/MARKETPLACE-SETUP.md). Token luu ma hoa bang SOCIAL_TOKEN_KEY. ---
# 1 = moi san chi kiem tra du lieu, khong gui that. San chua co ma app tu dong chay thu.
MARKETPLACE_DRY_RUN="0"
# Etsy Open API v3 (keystring + shared secret o https://www.etsy.com/developers/your-apps),
# callback: PUBLIC_BASE_URL/marketplace/callback/etsy
ETSY_API_KEY=""
ETSY_SHARED_SECRET=""
# Shopee Open Platform (open.shopee.com > App): Partner ID + Partner Key; SHOPEE_SANDBOX=1 = moi truong test cua Shopee
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_SANDBOX="0"
# Lazada Open Platform (open.lazada.com > App Console): App Key + App Secret; LAZADA_API_HOST mac dinh https://api.lazada.vn/rest
LAZADA_APP_KEY=""
LAZADA_APP_SECRET=""
# TikTok Shop Partner Center (partner.tiktokshop.com > App): App key, App secret, Service ID (trang ket noi shop)
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
TIKTOK_SHOP_SERVICE_ID=""
# Amazon SP-API (Seller Central > Develop Apps): LWA client id/secret + App ID (amzn1.sp.solution...)
# AMAZON_SP_DRAFT_APP=1 khi app chua publish; AMAZON_SP_REGION na|eu|fe; AMAZON_MARKETPLACE_ID mac dinh ATVPDKIKX0DER (amazon.com)
AMAZON_SP_CLIENT_ID=""
AMAZON_SP_CLIENT_SECRET=""
AMAZON_SP_APP_ID=""
AMAZON_SP_DRAFT_APP="1"
AMAZON_SP_REGION="na"
AMAZON_MARKETPLACE_ID="ATVPDKIKX0DER"

# Dich vu theu (Ink/Stitch, sanbox/emhaus-stitch-spike) cho trang /design; thu muc du lieu dung chung = STORAGE_DIR/design
STITCH_SERVICE_URL="http://127.0.0.1:8790"

# Bao khach can tu van qua Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Bao khach can tu van qua WhatsApp (CallMeBot, mien phi, chi ve so cua minh). De trong = tat.
CALLMEBOT_WHATSAPP_PHONE=""
CALLMEBOT_WHATSAPP_APIKEY=""

# Tim nguon noi dung (src/modules/curate). Openverse + Wikimedia Commons khong can key.
# Pexels: https://www.pexels.com/api/  (mien phi, 200 req/gio)
PEXELS_API_KEY=""
# Pixabay: https://pixabay.com/api/docs/  (mien phi, dang nhap se thay key)
PIXABAY_API_KEY=""
# Nhom bai viet cho bai nhap tao tu kho noi dung (mac dinh 24 = News)
CURATE_POST_CATALOGUE_ID="24"

# ---- Thong tin rieng cua tung site (de trong thi an) ----
# Link shop Etsy hien o footer / About / Contact
ETSY_SHOP_URL=""
# Ma <meta name="p:domain_verify"> de Pinterest xac nhan ten mien
PINTEREST_DOMAIN_VERIFY=""
# Chi de hien thi tren storefront (de trong thi an dong tuong ung), vd "Vietnam" / "United States"
NEXT_PUBLIC_STORE_TAGLINE=""
NEXT_PUBLIC_STORE_SHIPS_FROM=""
NEXT_PUBLIC_STORE_SHIP_TO=""
NEXT_PUBLIC_STORE_ORIGIN=""
